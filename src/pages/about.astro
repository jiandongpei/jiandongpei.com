---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
const title = 'About Jiandong Pei | SAP BTP & Enterprise AI Architecture';
const description = 'About Jiandong Pei: SAP BTP and enterprise AI architecture, Boundary Model creator, and builder-side experience across CAP, XSUAA, AppRouter, Work Zone, multitenancy, integration, and lifecycle.';
---
<BaseLayout {title} {description}>
  <section class="stack">
    <h1>About Jiandong Pei</h1>
    <p class="measure">My work focuses on SAP BTP and enterprise AI architecture, especially the boundaries between agents, extensions, workflows, and core business systems.</p>
    <p class="measure">AI can help teams create agents, applications, workflows, integrations, and extensions faster than before. But faster creation does not automatically create clear responsibility.</p>
  </section>

  <section class="stack">
    <h2>The questions I focus on</h2>
    <p class="measure">In SAP landscapes, the real architectural questions are often:</p>
    <ul>
      <li>What should become an agent?</li>
      <li>What should remain a governed extension?</li>
      <li>What belongs in workflow?</li>
      <li>What must stay anchored in S/4HANA or another system of record?</li>
      <li>Who owns business truth, execution authority, lifecycle, and accountability?</li>
    </ul>
  </section>

  <section class="stack">
    <h2>Builder-side SAP BTP background</h2>
    <ul>
      <li>Former SAP engineer with builder-side exposure to SAP BTP platform and extension architecture.</li>
      <li>Worked across CAP, XSUAA, AppRouter, Work Zone, multitenancy, integration, and lifecycle-related failure modes.</li>
      <li>Involved in SAP Build Code / Joule-era platform work and AI-assisted extension generation context.</li>
      <li>Experience diagnosing cross-product failures where local correctness did not produce global architectural validity.</li>
    </ul>
  </section>

  <section class="stack">
    <h2>The Boundary Model</h2>
    <p class="measure">The Boundary Model™ began as a way to analyze SAP BTP extension failure across runtime, identity, tenant, data, integration, and lifecycle boundaries.</p>
    <p class="measure">In the enterprise AI era, the same boundary discipline becomes necessary for agents, workflows, extensions, and core systems acting together.</p>
    <p class="measure">The point is not to make every AI initiative heavier. The point is to know where business truth, governed capability, process evidence, execution authority, and accountability belong.</p>
    <p><a href="/boundary-model/">Read the SAP BTP Boundary Model →</a> · <a href="/agent-extension-boundary-model/">Read the Agent–Extension Boundary Model →</a></p>
  </section>

  <section class="stack">
    <h2>What I claim</h2>
    <ul>
      <li>I provide independent architecture judgment.</li>
      <li>I classify boundary, jurisdiction, and responsibility failures.</li>
      <li>I issue fixed-scope written reviews and verdicts.</li>
      <li>I do not replace delivery teams.</li>
      <li>I write and publish openly on SAP BTP, Clean Core, S/4HANA extensibility, AI agents, workflows, CAP, multitenancy, and long-term architecture boundaries.</li>
    </ul>
  </section>

  <section class="stack">
    <h2>What I do not claim</h2>
    <ul>
      <li>I am not SAP official support.</li>
      <li>I do not speak for SAP.</li>
      <li>I do not sell implementation staffing.</li>
      <li>I do not claim every BTP or AI issue is architectural.</li>
      <li>I do not replace customer or vendor execution responsibility.</li>
    </ul>
  </section>

  <section class="stack">
    <div style="display:flex; gap:.75rem; flex-wrap:wrap;">
      <Button href="/work/" variant="primary">Work With Me</Button>
      <Button href="/contact/" variant="ghost">Send a 1-page summary</Button>
    </div>
  </section>
</BaseLayout>
