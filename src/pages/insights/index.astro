---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/Card.astro";
import { getCollection } from 'astro:content';
const title = 'Insights | SAP BTP & Enterprise AI Architecture';
const description = 'Essays on SAP BTP, enterprise AI architecture, agent-extension boundaries, Clean Core, S/4HANA extensibility, and post-go-live failure patterns where implementation success is not the same as architectural validity.';
const items = await getCollection('insights');
const records = items.map(i => ({ slug: i.slug, ...i.data }));
const featured = records.filter(r => r.featured);
const visibleRecords = records.filter(r => r.slug !== 'placeholder');
const archive = visibleRecords
  .map(r => ({...r, sortDate: r.published ?? r.date ?? ''}))
  .toSorted((a, b) => (a.sortDate > b.sortDate ? -1 : 1));
// Fixed boundary ordering aligned with the model
const boundaryOrder = ['Runtime','Identity','Tenant','Data','Integration','Lifecycle'];
const boundariesSet = new Set(visibleRecords.map(r => r.boundary).filter(b => b && b !== 'Boundary Model'));
const boundaries = boundaryOrder.filter(b => boundariesSet.has(b));
const byBoundary = Object.fromEntries(boundaries.map(b => [b, visibleRecords.filter(r => r.boundary === b)
  .map(r => ({...r, sortDate: r.published ?? r.date ?? ''}))
  .toSorted((a, b) => (a.sortDate > b.sortDate ? -1 : 1))]));
// Roles – curated paths
const rolePaths = [
  { role: 'CIO / CTO', path: 'Architecture Review · Strategic Boundary Verdict · Verdict Authority' },
  { role: 'Lead Architect', path: 'Identity · Tenant · Data · Integration · Lifecycle' },
  { role: 'Program Leadership', path: 'Full Boundary Audit · Ownership / jurisdiction map' },
  { role: 'Security Architect', path: 'Identity propagation · Trust boundaries · Security hardening' },
  { role: 'Integration Lead', path: 'Integration Boundary · Cross-system contracts' },
];
---
<BaseLayout {title} {description}>
  <section class="stack tight">
    <h1>Insights</h1>
    <p class="measure">Essays on SAP BTP, enterprise AI architecture, agent-extension boundaries, Clean Core, S/4HANA extensibility, and post-go-live failure patterns where implementation success is not the same as architectural validity.</p>
  </section>

  <section class="stack">
    <h2>Enterprise AI / Agent Architecture</h2>
    <div class="stack">
      <Card title="Agent–Extension Boundary Model">
        <p class="measure">A responsibility model for SAP agents, extensions, workflows, assistants, and core business systems.</p>
        <a href="/agent-extension-boundary-model/">Read →</a>
      </Card>
      <Card title="Agent, Extension, or Workflow?">
        <p class="measure">A practical decision guide before enterprise AI creates responsibility drift.</p>
        <a href="/sap-agent-extension-workflow/">Read →</a>
      </Card>
      <Card title="SAP AI Agent Security Is Not Just Identity">
        <p class="measure">Why valid tokens are not enough when RAG, tools, workflows, and model context introduce new authorization boundaries.</p>
        <a href="/insights/a024-your-sap-agent-has-a-token/">Read →</a>
      </Card>
      <Card title="Full essay: Agents Do Not Replace Extensions">
        <p class="measure">The full A023 essay behind the Agent–Extension Boundary Model and responsibility taxonomy for SAP enterprise AI.</p>
        <a href="/insights/a023-agents-do-not-replace-extensions/">Read →</a>
      </Card>
      <Card title="Is This Agent Safe to Execute?">
        <p class="measure">The Boundary Model for SAP enterprise agents in the age of trusted execution.</p>
        <a href="/insights/a022-is-this-agent-safe-to-execute/">Read →</a>
      </Card>
      <Card title="Enterprise AI Responsibility Architecture">
        <p class="measure">Why agent governance is not enough without truth, execution, lifecycle, and accountability boundaries.</p>
        <a href="/enterprise-ai-responsibility-architecture/">Read →</a>
      </Card>
      <Card title="AI-Generated Extensions on SAP BTP">
        <p class="measure">AI accelerates code generation, but boundary correctness still determines whether extensions remain stable by tenant, identity path, and lifecycle over time.</p>
        <a href="/insights/a004-ai-generated-extensions-on-btp/">Read →</a>
      </Card>
    </div>
    <p class="measure muted">Future topics: Agent Memory Is Not Business Truth; Agent Lifecycle Is Behavior Migration.</p>
  </section>

  {featured.length > 0 && (
    <section class="stack">
      <h2>Core essays</h2>
      <div class="stack">
        {featured.map((e) => (
          <Card title={e.title}>
            {e.summary && (<p class="measure">{e.summary}</p>)}
            <a href={`/insights/${e.slug}/`}>Read →</a>
          </Card>
        ))}
      </div>
    </section>
  )}

  {boundaries.length > 0 && (
    <section class="stack">
      <h2>Boundary Model / SAP BTP Failure</h2>
      {boundaries.map((b) => (
        <div class="card">
          <div class="eyebrow">Boundary</div>
          <h3>{b}</h3>
          <ul>
            {byBoundary[b].slice(0, 4).map((e) => (
              <li>
                <a href={`/insights/${e.slug}/`}><strong>{e.title}</strong></a>
                {e.summary && (<span class="muted"> — {e.summary}</span>)}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  <section class="stack">
    <h2>Clean Core / Governance / Long-Term Architecture</h2>
    <ul>
      <li><a href="/insights/a015-clean-core/"><strong>Clean Core: The Architectural Reason SAP Never Fully Explained</strong></a></li>
      <li><a href="/insights/a021-rise-does-not-decide-your-sap-btp-extension-architecture/"><strong>RISE Does Not Decide Your SAP BTP Extension Architecture</strong></a></li>
      <li><a href="/insights/a006-stability-window/"><strong>The Stability Window of BTP Extensions</strong></a></li>
      <li><a href="/insights/a020-when-btp-extension-problem-stops-being-delivery-problem/"><strong>When a SAP BTP Extension Problem Stops Being a Delivery Problem</strong></a></li>
    </ul>
  </section>

  <section class="stack">
    <h2>Explore by real‑world symptom</h2>
    <ul>
      <li><a href="/cases/postman-worked-work-zone-failed/">Works in Postman; fails behind App Router/Work Zone</a></li>
      <li><a href="/cases/one-tenant-worked-next-exposed-wrong-architecture/">One tenant works; the next exposes the wrong architecture</a></li>
      <li><a href="/sap-btp-post-go-live-failure-assessment/">The demo passed; the rollout model never existed</a></li>
      <li><a href="/cases/security-hardening-broke-extension/">Security hardening reveals an ungovernable architecture</a></li>
      <li><a href="/cases/vendors-disagreed-no-one-owned-chain/">Every team is locally correct; the system is globally wrong</a></li>
    </ul>
  </section>

  <section class="stack">
    <h2>Not every failure pattern is a bug</h2>
    <p class="measure">Many recurring SAP BTP extension failures are boundary and jurisdiction failures. Use the patterns to recognize the situation, then move to a decision.</p>
    <p><a href="/failure-patterns/">See failure patterns →</a> · <a href="/implementation-vs-verdict/">Implementation vs verdict →</a> · <a href="/sap-btp-architecture-review/">SAP BTP Architecture Review →</a> · <a href="/sap-btp-extension-audit/">SAP BTP Extension Audit →</a></p>
  </section>

  <section class="stack">
    <h2>Prefer concrete, recognizable situations?</h2>
    <p class="measure">See <a href="/representative-cases/">Representative Cases</a> — anonymized post‑go‑live cases that connect the model to live system reality.</p>
  </section>

  <section class="stack">
    <h2>Read by role</h2>
    <ul>
      {rolePaths.map(r => (<li><strong>{r.role}</strong> → {r.path}</li>))}
    </ul>
  </section>

  <section class="stack">
    <h2>Full archive</h2>
    <ul>
      {archive.map((e) => (
        <li>
          <a href={`/insights/${e.slug}/`}><strong>{e.title}</strong></a>
          {e.published && (<span class="muted"> — {e.published}</span>)}
          {e.subtitle && (<div class="muted">{e.subtitle}</div>)}
          {!e.subtitle && e.summary && (<div class="muted">{e.summary}</div>)}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
