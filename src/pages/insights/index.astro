---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/Card.astro";
import { getCollection } from 'astro:content';
const title = 'SAP BTP Architecture Insights - Boundary Model, Clean Core, Agents';
const description = 'SAP BTP architecture insights on Boundary Model, Clean Core, identity propagation, multitenancy, Work Zone AppRouter, integration, lifecycle, Joule, and enterprise AI agents.';
const items = await getCollection('insights');
const records = items.map(i => ({ slug: i.slug, ...i.data }));
const featured = records.filter(r => r.featured);
const visibleRecords = records.filter(r => r.slug !== 'placeholder');
const archive = visibleRecords
  .map(r => ({...r, sortDate: r.published ?? r.date ?? ''}))
  .toSorted((a, b) => (a.sortDate > b.sortDate ? -1 : 1));
// Fixed boundary ordering aligned with the model
const boundaryOrder = ['Runtime','Identity','Tenant','Data','Integration','Lifecycle','Execution','Responsibility','Authorization'];
const boundariesSet = new Set(visibleRecords.map(r => r.boundary).filter(b => b && b !== 'Boundary Model'));
const boundaries = boundaryOrder.filter(b => boundariesSet.has(b));
const byBoundary = Object.fromEntries(boundaries.map(b => [b, visibleRecords.filter(r => r.boundary === b)
  .map(r => ({...r, sortDate: r.published ?? r.date ?? ''}))
  .toSorted((a, b) => (a.sortDate > b.sortDate ? -1 : 1))]));
// Roles – curated paths
const rolePaths = [
  { role: 'CIO / CTO', path: 'Architecture Review · Strategic Boundary Verdict · Verdict Authority' },
  { role: 'Lead Architect', path: 'Identity · Tenant · Data · Integration · Lifecycle' },
  { role: 'Program Leadership', path: 'Full Boundary Audit · Ownership / jurisdiction map' },
  { role: 'Security Architect', path: 'Identity propagation · Trust boundaries · Security hardening' },
  { role: 'Integration Lead', path: 'Integration Boundary · Cross-system contracts' },
];
const situationPaths = [
  {
    title: 'If Postman works but Work Zone fails',
    body: 'Start with identity propagation, AppRouter, Work Zone, runtime surface, and integration boundary analysis.',
    links: [
      { href: '/insights/a012-why-identity-breaks/', label: 'Why SAP BTP Identity Breaks' },
      { href: '/insights/a019-integration-boundary/', label: 'The Integration Boundary' },
      { href: '/cases/postman-worked-work-zone-failed/', label: 'Representative case' },
    ],
  },
  {
    title: 'If one tenant works but the next breaks',
    body: 'Treat the first successful tenant as insufficient proof. Look at tenant isolation, onboarding, routing, and lifecycle contracts.',
    links: [
      { href: '/insights/a025-tenant-boundary-on-sap-btp/', label: 'Tenant Boundary on SAP BTP' },
      { href: '/insights/a001-inside-sap-btp/', label: 'Inside SAP BTP' },
      { href: '/insights/a002-why-single-customer-must-use-multitenancy/', label: 'Why even single-customer extensions must use multitenancy' },
      { href: '/cases/one-tenant-worked-next-exposed-wrong-architecture/', label: 'Representative case' },
    ],
  },
  {
    title: 'If S/4 data is copied into HDI',
    body: 'The question is not whether the copy works. It is whether business truth, write authority, and lifecycle remain governed.',
    links: [
      { href: '/insights/a014-why-data-boundaries-break/', label: 'Why SAP BTP Data Boundaries Break' },
      { href: '/cases/data-copy-worked-shadow-truth-froze-lifecycle/', label: 'Representative case' },
    ],
  },
  {
    title: 'If RISE is approved but extension architecture remains unclear',
    body: 'RISE and Clean Core set direction. They do not prove the SAP BTP extension architecture is structurally safe to evolve.',
    links: [
      { href: '/insights/a021-rise-does-not-decide-your-sap-btp-extension-architecture/', label: 'RISE Does Not Decide Your SAP BTP Extension Architecture' },
      { href: '/insights/a015-clean-core/', label: 'Clean Core: The Architectural Reason' },
      { href: '/sap-btp-architecture-review/', label: 'SAP BTP Architecture Review' },
    ],
  },
  {
    title: 'If AI agents, workflows, and extensions blur responsibility',
    body: 'Classify truth, capability, process, execution, context, lifecycle, and accountability before the agent acts.',
    links: [
      { href: '/insights/a022-is-this-agent-safe-to-execute/', label: 'Is This Agent Safe to Execute?' },
      { href: '/insights/a023-agents-do-not-replace-extensions/', label: 'Agent, Extension, or Workflow?' },
      { href: '/insights/a024-your-sap-agent-has-a-token/', label: 'SAP AI Agent Security Is Not Just Identity' },
    ],
  },
  {
    title: 'If the system runs but cannot evolve',
    body: 'Look at lifecycle, reconstructibility, ownership, and whether the architecture depends on manual repair to survive change.',
    links: [
      { href: '/insights/a026-model-upgrade-boundary/', label: 'The Model Upgrade Boundary' },
      { href: '/insights/a006-stability-window/', label: 'The Stability Window of BTP Extensions' },
      { href: '/insights/a020-when-btp-extension-problem-stops-being-delivery-problem/', label: 'When a BTP Extension Problem Stops Being a Delivery Problem' },
      { href: '/failure-patterns/', label: 'Failure Patterns' },
    ],
  },
];
---
<BaseLayout {title} {description}>
  <section class="stack tight">
    <h1>Insights</h1>
    <p class="measure">Essays on SAP BTP, enterprise AI architecture, agent-extension boundaries, Clean Core, S/4HANA extensibility, and post-go-live failure patterns where implementation success is not the same as architectural validity.</p>
  </section>

  <section class="stack">
    <h2>Where to start</h2>
    <div class="cards-grid">
      <Card title="New here">
        <p>Start with Read by Situation. Pick the symptom your team recognizes before choosing a model or service page.</p>
      </Card>
      <Card title="Already know the boundary">
        <p>Use Read by Boundary if the problem is already clearly about identity, tenant, data, integration, lifecycle, execution, or authorization.</p>
      </Card>
      <Card title="Evaluating Jiandong">
        <p>Start with Core essays, About, and For Architecture Teams to assess builder-side experience, SAP BTP / Enterprise AI boundary judgment, and internal capability fit.</p>
        <p><a href="/about/">About -></a> · <a href="/for-architecture-teams/">For Architecture Teams -></a></p>
      </Card>
    </div>
  </section>

  <section class="stack">
    <h2>Read by Situation</h2>
    <p class="measure">Start from the symptom your team recognizes. The article path should lead to a boundary decision, not just more content.</p>
    <div class="cards-grid">
      {situationPaths.map((s) => (
        <Card title={s.title}>
          <p>{s.body}</p>
          <ul>
            {s.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </Card>
      ))}
    </div>
  </section>

  <section class="stack">
    <h2>Enterprise AI / Agent Architecture</h2>
    <div class="stack">
      <Card title="Agent–Extension Boundary Model">
        <p class="measure">A responsibility model for SAP agents, extensions, workflows, assistants, and core business systems.</p>
        <a href="/agent-extension-boundary-model/">Read →</a>
      </Card>
      <Card title="Agent, Extension, or Workflow?">
        <p class="measure">A practical decision guide before enterprise AI creates responsibility drift.</p>
        <a href="/sap-agent-extension-workflow/">Read →</a>
      </Card>
      <Card title="SAP AI Agent Security Is Not Just Identity">
        <p class="measure">Why valid tokens are not enough when RAG, tools, workflows, and model context introduce new authorization boundaries.</p>
        <a href="/insights/a024-your-sap-agent-has-a-token/">Read →</a>
      </Card>
      <Card title="Why Autonomous Enterprise Cannot Be Model-Driven">
        <p class="measure">The model can change, but enterprise behavior cannot drift without explicit lifecycle governance.</p>
        <a href="/insights/a026-model-upgrade-boundary/">Read →</a>
      </Card>
      <Card title="Full essay: Agents Do Not Replace Extensions">
        <p class="measure">The full A023 essay behind the Agent–Extension Boundary Model and responsibility taxonomy for SAP enterprise AI.</p>
        <a href="/insights/a023-agents-do-not-replace-extensions/">Read →</a>
      </Card>
      <Card title="Is This Agent Safe to Execute?">
        <p class="measure">The Boundary Model for SAP enterprise agents in the age of trusted execution.</p>
        <a href="/insights/a022-is-this-agent-safe-to-execute/">Read →</a>
      </Card>
      <Card title="Enterprise AI Responsibility Architecture">
        <p class="measure">Why agent governance is not enough without truth, execution, lifecycle, and accountability boundaries.</p>
        <a href="/enterprise-ai-responsibility-architecture/">Read →</a>
      </Card>
      <Card title="AI-Generated Extensions on SAP BTP">
        <p class="measure">AI accelerates code generation, but boundary correctness still determines whether extensions remain stable by tenant, identity path, and lifecycle over time.</p>
        <a href="/insights/a004-ai-generated-extensions-on-btp/">Read →</a>
      </Card>
    </div>
    <p class="measure muted">Future topics: Agent Memory Is Not Business Truth; Agent Lifecycle Is Behavior Migration.</p>
  </section>

  {featured.length > 0 && (
    <section class="stack">
      <h2>Core essays</h2>
      <div class="stack">
        {featured.map((e) => (
          <Card title={e.title}>
            {e.summary && (<p class="measure">{e.summary}</p>)}
            <a href={`/insights/${e.slug}/`}>Read →</a>
          </Card>
        ))}
      </div>
    </section>
  )}

  {boundaries.length > 0 && (
    <section class="stack">
      <h2>Read by Boundary</h2>
      {boundaries.map((b) => (
        <div class="card">
          <div class="eyebrow">Boundary</div>
          <h3>{b}</h3>
          <ul>
            {byBoundary[b].slice(0, 4).map((e) => (
              <li>
                <a href={`/insights/${e.slug}/`}><strong>{e.title}</strong></a>
                {e.summary && (<span class="muted"> — {e.summary}</span>)}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  <section class="stack">
    <h2>Clean Core / Governance / Long-Term Architecture</h2>
    <ul>
      <li><a href="/insights/a015-clean-core/"><strong>Clean Core: The Architectural Reason SAP Never Fully Explained</strong></a></li>
      <li><a href="/insights/a021-rise-does-not-decide-your-sap-btp-extension-architecture/"><strong>RISE Does Not Decide Your SAP BTP Extension Architecture</strong></a></li>
      <li><a href="/insights/a006-stability-window/"><strong>The Stability Window of BTP Extensions</strong></a></li>
      <li><a href="/insights/a020-when-btp-extension-problem-stops-being-delivery-problem/"><strong>When a SAP BTP Extension Problem Stops Being a Delivery Problem</strong></a></li>
    </ul>
  </section>

  <section class="stack">
    <h2>Not every failure pattern is a bug</h2>
    <p class="measure">Many recurring SAP BTP extension failures are boundary and jurisdiction failures. Use the patterns to recognize the situation, then move to a decision.</p>
    <p><a href="/failure-patterns/">See failure patterns →</a> · <a href="/implementation-vs-verdict/">Implementation vs verdict →</a> · <a href="/sap-btp-architecture-review/">SAP BTP Architecture Review →</a> · <a href="/sap-btp-extension-audit/">SAP BTP Extension Audit →</a></p>
  </section>

  <section class="stack">
    <h2>Prefer concrete, recognizable situations?</h2>
    <p class="measure">See <a href="/representative-cases/">Representative Cases</a> — anonymized post‑go‑live cases that connect the model to live system reality.</p>
  </section>

  <section class="stack">
    <h2>Read by role</h2>
    <ul>
      {rolePaths.map(r => (<li><strong>{r.role}</strong> → {r.path}</li>))}
    </ul>
  </section>

  <section class="stack">
    <h2>Full archive</h2>
    <ul>
      {archive.map((e) => (
        <li>
          <a href={`/insights/${e.slug}/`}><strong>{e.title}</strong></a>
          {e.published && (<span class="muted"> — {e.published}</span>)}
          {e.subtitle && (<div class="muted">{e.subtitle}</div>)}
          {!e.subtitle && e.summary && (<div class="muted">{e.summary}</div>)}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
