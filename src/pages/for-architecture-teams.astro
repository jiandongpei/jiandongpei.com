---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import Card from "@components/Card.astro";

const title = 'For Architecture Teams | SAP BTP & Enterprise AI Boundary Judgment';
const description = 'For product, platform, architecture, and AI governance teams evaluating whether SAP BTP and enterprise AI boundary judgment belongs inside the organization.';
---
<BaseLayout {title} {description}>
  <section class="stack hero tight">
    <div class="eyebrow">Internal capability fit</div>
    <h1>For Architecture Teams</h1>
    <p class="lede">When SAP BTP and Enterprise AI boundary judgment belongs inside the organization.</p>
    <p class="measure">Some organizations need a fixed-scope external verdict for a specific decision. Others need this kind of SAP BTP and enterprise AI boundary judgment inside a product, platform, architecture, or AI governance team.</p>
    <p class="measure">I am open to senior architecture, platform engineering, and enterprise AI governance roles where SAP BTP, Clean Core extensions, multitenancy, identity, lifecycle, and agent execution boundaries matter.</p>
  </section>

  <section class="stack">
    <h2>Internal Capability Snapshot</h2>
    <div class="cards-grid">
      <Card title="Internal role patterns">
        <ul>
          <li>SAP BTP Architect</li>
          <li>Enterprise Architect - SAP / Cloud / AI</li>
          <li>Staff / Principal Engineer - SAP BTP / Platform</li>
          <li>Enterprise AI Architect - Agents / Governance</li>
        </ul>
      </Card>
      <Card title="Core strength">
        <p>SAP builder-side BTP experience combined with Boundary Model judgment across identity, tenancy, lifecycle, integration, Clean Core extensions, and AI agent governance.</p>
      </Card>
      <Card title="Best fit">
        <p>Teams building or governing SAP BTP extensions, Clean Core landscapes, developer platforms, SAP Build Code / Joule-adjacent capabilities, or enterprise AI execution systems.</p>
      </Card>
      <Card title="Role-specific materials">
        <p>Role-specific resume materials can be provided for relevant discussions. Public evidence and featured artifacts are available through LinkedIn.</p>
        <p><a href="https://www.linkedin.com/in/peijiandong/" target="_blank" rel="noopener">View LinkedIn -></a></p>
      </Card>
    </div>
  </section>

  <section class="stack">
    <h2>Role fit</h2>
    <div class="cards-grid">
      <Card title="Architecture and platform roles">
        <ul>
          <li>SAP BTP Architect</li>
          <li>Enterprise Architect - SAP / Cloud / AI</li>
          <li>Principal Software Engineer - SAP BTP / Platform</li>
          <li>Staff Engineer - Developer Platform / Enterprise AI</li>
        </ul>
      </Card>
      <Card title="SAP extension and AI roles">
        <ul>
          <li>Solution Architect - Clean Core / S/4HANA Extensions</li>
          <li>AI Platform Architect - Enterprise Agents / Governance</li>
          <li>Developer Platform Architect</li>
          <li>Integration / Identity / Multitenancy Architect</li>
        </ul>
      </Card>
    </div>
  </section>

  <section class="stack">
    <h2>Internal capability mode</h2>
    <p class="measure">This page is for organizations evaluating whether SAP BTP / Enterprise AI boundary judgment should exist inside the team rather than only through an external review.</p>
    <p class="measure">For fixed-scope external verdicts, use <a href="/work/">Work With Me</a>.</p>
  </section>

  <section class="stack">
    <h2>Core capabilities</h2>
    <div class="cards-grid">
      <Card title="SAP BTP Architecture">
        <ul>
          <li>CAP / LCAP</li>
          <li>XSUAA, IAS, AppRouter, Work Zone</li>
          <li>HDI, multitenancy, SaaS enablement</li>
          <li>S/4HANA extensions and Clean Core</li>
          <li>Identity, tenant, data, integration, runtime, and lifecycle boundaries</li>
        </ul>
      </Card>
      <Card title="Enterprise AI / Joule / Agent Architecture">
        <ul>
          <li>SAP Build Code / Joule early integration context</li>
          <li>AI-assisted extension generation</li>
          <li>Agent / workflow / extension responsibility model</li>
          <li>AI governance through boundaries</li>
          <li>Contract-bound generation and execution safety</li>
        </ul>
      </Card>
      <Card title="Platform / Engineering Depth">
        <ul>
          <li>Service broker experience</li>
          <li>HANA XSA / SDS / streaming analytics</li>
          <li>Runtime and lifecycle problems</li>
          <li>Security and identity chain debugging</li>
          <li>Cross-product architecture troubleshooting</li>
        </ul>
      </Card>
    </div>
  </section>

  <section class="stack">
    <h2>Differentiation</h2>
    <p class="measure">My differentiator is builder-side experience: I have not only used SAP BTP from the outside, but worked on platform-side capabilities and boundary-heavy problems inside SAP.</p>
    <p class="measure">That background is useful when a team needs someone who can reason across product boundaries, identity chains, tenant models, lifecycle exposure, integration contracts, and enterprise AI responsibility rather than only deliver a local implementation.</p>
  </section>

  <section class="stack">
    <h2>Best-fit organizations</h2>
    <div class="cards-grid">
      <Card title="SAP platform and product teams">
        <p>Teams building developer platforms, SAP BTP extension foundations, AI-assisted development experiences, or cross-product architecture where platform contracts matter.</p>
      </Card>
      <Card title="Enterprise architecture teams">
        <p>Organizations governing Clean Core, S/4HANA side-by-side extensions, multitenancy, identity, integration, and long-term lifecycle decisions.</p>
      </Card>
      <Card title="Enterprise AI teams">
        <p>Teams deciding how agents, workflows, tools, RAG, extensions, and systems of record should cooperate without collapsing responsibility boundaries.</p>
      </Card>
    </div>
  </section>

  <section class="stack">
    <h2>Not the primary target</h2>
    <p class="measure">I am less useful for roles centered mainly on ticket execution, pure configuration, short-term feature staffing, or routine project coordination. The strongest fit is where the organization needs architecture judgment that changes platform direction, governance, or long-term system safety.</p>
  </section>

  <section class="stack">
    <h2>How to evaluate fit</h2>
    <ul>
      <li>Use this site to evaluate architectural depth, writing clarity, and SAP BTP / enterprise AI judgment.</li>
      <li>Use LinkedIn for public evidence and featured artifacts.</li>
      <li>Role-specific resume materials are managed separately and can be provided for relevant discussions.</li>
    </ul>
    <div style="display:flex; gap:.75rem; flex-wrap:wrap;">
      <Button href="https://www.linkedin.com/in/peijiandong/" variant="primary">View LinkedIn</Button>
      <Button href="/contact/" variant="ghost">Discuss internal fit</Button>
      <Button href="/about/" variant="ghost">Read background</Button>
    </div>
  </section>
</BaseLayout>
