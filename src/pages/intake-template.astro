---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";

const title = 'SAP BTP Architecture Review Intake Template';
const description = 'One-page intake template for requesting an independent SAP BTP architecture review, enterprise AI responsibility review, extension audit, or boundary verdict.';
const template = `Subject: SAP BTP Boundary Review Request - [Company / Situation]

1. Landscape:
2. Business action or extension scenario:
3. Current symptom:
4. Systems involved:
5. Identity / tenant / data / integration / lifecycle surfaces involved:
6. Timeline:
7. Teams or stakeholders involved:
8. Decision that cannot converge:
9. Desired next step:`;
---
<BaseLayout {title} {description}>
  <section class="stack hero tight">
    <h1>Architecture Intake Template</h1>
    <p class="lede">Use this page to prepare the one-page summary for an independent SAP BTP architecture review, enterprise AI responsibility review, extension audit, or boundary verdict.</p>
  </section>

  <section class="stack">
    <h2>Use this template</h2>
    <p class="measure">Keep it factual and compressed. The goal is not to prove your team is right. The goal is to make the architecture legible enough to assess whether a fixed-scope verdict format applies.</p>
  </section>

  <section class="stack">
    <h2>Landscape</h2>
    <p class="measure">List the relevant S/4 systems, BTP runtimes, entry surfaces, identity chain, and tenant model. Only include what materially shapes runtime truth.</p>
  </section>

  <section class="stack">
    <h2>Business action or extension scenario</h2>
    <p class="measure">Describe what the user, assistant, agent, workflow, extension, or core system is expected to do.</p>
  </section>

  <section class="stack">
    <h2>Current symptom</h2>
    <p class="measure">State what works, what fails, where it fails, and which tenant, path, user group, workflow state, or agent behavior exposes the difference.</p>
  </section>

  <section class="stack">
    <h2>Timeline</h2>
    <p class="measure">Include go-live date, relevant rollout or hardening milestones, and the moment the divergence became visible.</p>
  </section>

  <section class="stack">
    <h2>Decision that cannot converge</h2>
    <p class="measure">Describe the decision itself, the competing interpretations, and the business consequence of delay. This is usually more important than the incident chronology.</p>
  </section>

  <section class="stack">
    <h2>Known constraints</h2>
    <p class="measure">Add only the constraints that materially bound the verdict: release windows, compliance posture, clean core restrictions, contractual boundaries, or pre-committed rollout obligations.</p>
  </section>

  <section class="stack">
    <h2>What not to include</h2>
    <p class="measure">Do not attach every log, ticket, or meeting note. Do not turn the intake into a defense brief. The first pass is for classification, not exhaustive evidence handling.</p>
  </section>

  <section class="stack">
    <h2>Copyable template</h2>
    <pre class="code-diagram"><code>{template}</code></pre>
  </section>

  <section class="stack cta">
    <p class="measure">After preparing the summary, send it by email or LinkedIn through the <a href="/contact/">Contact</a> page.</p>
    <div style="display:flex; gap:.75rem; flex-wrap:wrap;">
      <Button href="/contact/" variant="primary">Send structured summary</Button>
      <Button href="/work/" variant="ghost">See verdict services</Button>
    </div>
  </section>
</BaseLayout>
